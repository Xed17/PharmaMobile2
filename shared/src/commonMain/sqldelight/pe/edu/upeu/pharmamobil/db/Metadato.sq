CREATE TABLE metadato (
    cuentaClave TEXT NOT NULL,
    clave TEXT NOT NULL,
    valor TEXT NOT NULL,
    PRIMARY KEY(cuentaClave, clave)
);

obtener:
SELECT valor FROM metadato WHERE cuentaClave = :cuentaClave AND clave = :clave;

guardar:
INSERT OR REPLACE INTO metadato(cuentaClave, clave, valor) VALUES (:cuentaClave, :clave, :valor);
