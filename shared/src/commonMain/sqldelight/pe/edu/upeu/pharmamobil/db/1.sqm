ALTER TABLE producto RENAME TO producto_v1;
ALTER TABLE metadato RENAME TO metadato_v1;
CREATE TABLE producto (
    cuentaClave TEXT NOT NULL,
    id INTEGER NOT NULL,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    activo INTEGER,
    categoriaId INTEGER,
    categoriaNombre TEXT,
    datosIncompletos INTEGER NOT NULL DEFAULT 0,
    pendiente INTEGER NOT NULL DEFAULT 0,
    estadoEnvio TEXT NOT NULL DEFAULT 'CONFIRMADO',
    intentos INTEGER NOT NULL DEFAULT 0 CHECK(intentos >= 0),
    revision INTEGER NOT NULL DEFAULT 0,
    operacionLocalId TEXT,
    ultimoErrorCodigo TEXT,
    ultimoError TEXT,
    erroresCampos TEXT,
    proximoIntentoEnMs INTEGER,
    PRIMARY KEY(cuentaClave, id)
);
CREATE TABLE metadato (
    cuentaClave TEXT NOT NULL,
    clave TEXT NOT NULL,
    valor TEXT NOT NULL,
    PRIMARY KEY(cuentaClave, clave)
);
CREATE TABLE borrador_producto (
    cuentaClave TEXT NOT NULL PRIMARY KEY,
    idEdicion INTEGER,
    nombre TEXT NOT NULL,
    precioTexto TEXT NOT NULL,
    stockTexto TEXT NOT NULL,
    categoriaId INTEGER,
    categoriaNombre TEXT,
    version INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE descarga (
    cuentaClave TEXT NOT NULL PRIMARY KEY,
    cadenaId TEXT NOT NULL,
    estado TEXT NOT NULL,
    intentos INTEGER NOT NULL CHECK(intentos BETWEEN 0 AND 5),
    proximoEnMs INTEGER,
    agotadaEnMs INTEGER,
    ultimoErrorCodigo TEXT,
    ultimoError TEXT
);
CREATE TABLE historial_envio (
    cuentaClave TEXT NOT NULL,
    operacionLocalId TEXT NOT NULL,
    revision INTEGER NOT NULL,
    intento INTEGER NOT NULL,
    estado TEXT NOT NULL,
    codigo TEXT,
    mensajeSeguro TEXT,
    instanteMs INTEGER NOT NULL,
    PRIMARY KEY(cuentaClave, operacionLocalId, revision, intento)
);

INSERT INTO producto(cuentaClave,id,nombre,precio,stock,pendiente,estadoEnvio,datosIncompletos)
SELECT 'legacy_unassigned',id,nombre,precio,stock,pendiente,
CASE WHEN pendiente = 1 THEN 'REVISION' ELSE 'CONFIRMADO' END,1 FROM producto_v1;
INSERT INTO metadato(cuentaClave,clave,valor)
SELECT 'legacy_unassigned',clave,valor FROM metadato_v1;
DROP TABLE producto_v1;
DROP TABLE metadato_v1;
