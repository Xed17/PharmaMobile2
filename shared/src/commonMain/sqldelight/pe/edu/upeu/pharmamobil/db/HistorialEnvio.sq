CREATE TABLE historial_envio (
    cuentaClave TEXT NOT NULL,
    operacionLocalId TEXT NOT NULL,
    revision INTEGER NOT NULL,
    intento INTEGER NOT NULL,
    estado TEXT NOT NULL,
    codigo TEXT,
    mensajeSeguro TEXT,
    instanteMs INTEGER NOT NULL,
    PRIMARY KEY(cuentaClave, operacionLocalId, revision, intento)
);

