CREATE TABLE producto (
    cuentaClave TEXT NOT NULL,
    id INTEGER NOT NULL,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    activo INTEGER,
    categoriaId INTEGER,
    categoriaNombre TEXT,
    datosIncompletos INTEGER NOT NULL DEFAULT 0,
    pendiente INTEGER NOT NULL DEFAULT 0,
    estadoEnvio TEXT NOT NULL DEFAULT 'CONFIRMADO',
    intentos INTEGER NOT NULL DEFAULT 0 CHECK(intentos >= 0),
    revision INTEGER NOT NULL DEFAULT 0,
    operacionLocalId TEXT,
    ultimoErrorCodigo TEXT,
    ultimoError TEXT,
    erroresCampos TEXT,
    proximoIntentoEnMs INTEGER,
    PRIMARY KEY(cuentaClave, id)
);

listarTodos:
SELECT * FROM producto WHERE cuentaClave = :cuentaClave AND datosIncompletos = 0 ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE cuentaClave = :cuentaClave AND pendiente = 1 AND datosIncompletos = 0 ORDER BY id DESC;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) - 1 FROM producto WHERE cuentaClave = :cuentaClave AND id < 0;

insertar:
INSERT OR REPLACE INTO producto(cuentaClave, id, nombre, precio, stock, activo, categoriaId, categoriaNombre, pendiente, estadoEnvio, operacionLocalId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto WHERE cuentaClave = :cuentaClave AND pendiente = 0;

eliminarPorId:
DELETE FROM producto WHERE cuentaClave = :cuentaClave AND id = :id;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE cuentaClave = :cuentaClave AND pendiente = 1 AND datosIncompletos = 0;

envios:
SELECT * FROM producto WHERE cuentaClave = :cuentaClave AND pendiente = 1 AND datosIncompletos = 0 ORDER BY id DESC;

porIdLocal:
SELECT * FROM producto WHERE cuentaClave = :cuentaClave AND id = :id AND datosIncompletos = 0;

elegibles:
SELECT * FROM producto WHERE cuentaClave = :cuentaClave AND pendiente = 1 AND datosIncompletos = 0
AND estadoEnvio = 'PENDIENTE' AND intentos < :maxIntentos
AND (proximoIntentoEnMs IS NULL OR proximoIntentoEnMs <= :ahoraMs) ORDER BY id DESC;

iniciarEnvio:
UPDATE producto SET estadoEnvio = 'ENVIANDO', intentos = intentos + 1
WHERE cuentaClave = :cuentaClave AND id = :id AND estadoEnvio = 'PENDIENTE' AND intentos < :maxIntentos
AND (proximoIntentoEnMs IS NULL OR proximoIntentoEnMs <= :ahoraMs);

cambios:
SELECT changes();

resolverError:
UPDATE producto SET estadoEnvio = :estadoEnvio, ultimoErrorCodigo = :codigo, ultimoError = :mensaje,
erroresCampos = :campos, proximoIntentoEnMs = :proximo
WHERE cuentaClave = :cuentaClave AND id = :id;

liberarEnvio:
UPDATE producto SET estadoEnvio = 'PENDIENTE' WHERE cuentaClave = :cuentaClave AND id = :id;

nuevaRevision:
UPDATE producto SET estadoEnvio = 'PENDIENTE', intentos = 0, revision = revision + 1,
proximoIntentoEnMs = NULL WHERE cuentaClave = :cuentaClave AND id = :id;

corregirEnvio:
UPDATE producto SET nombre = :nombre, precio = :precio, stock = :stock, activo = :activo,
categoriaId = :categoriaId, categoriaNombre = :categoriaNombre, estadoEnvio = 'PENDIENTE',
intentos = 0, revision = revision + 1, proximoIntentoEnMs = NULL
WHERE cuentaClave = :cuentaClave AND id = :id;
