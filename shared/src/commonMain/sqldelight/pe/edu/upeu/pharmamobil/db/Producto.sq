CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0
);

listarTodos:
SELECT *
FROM producto
ORDER BY nombre ASC;

listarPendientes:
SELECT *
FROM producto
WHERE pendiente = 1
ORDER BY id DESC;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) - 1
FROM producto
WHERE id < 0;

insertar:
INSERT OR REPLACE INTO producto(id, nombre, precio, stock, pendiente)
VALUES (?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto
WHERE pendiente = 0;

eliminarPorId:
DELETE FROM producto
WHERE id = ?;

contarPendientes:
SELECT COUNT(*)
FROM producto
WHERE pendiente = 1;
