CREATE TABLE borrador_producto (
    cuentaClave TEXT NOT NULL PRIMARY KEY,
    idEdicion INTEGER,
    nombre TEXT NOT NULL,
    precioTexto TEXT NOT NULL,
    stockTexto TEXT NOT NULL,
    categoriaId INTEGER,
    categoriaNombre TEXT,
    version INTEGER NOT NULL DEFAULT 0
);

obtener:
SELECT * FROM borrador_producto WHERE cuentaClave = :cuentaClave;

guardar:
INSERT OR REPLACE INTO borrador_producto(cuentaClave, idEdicion, nombre, precioTexto, stockTexto, categoriaId, categoriaNombre, version)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

borrar:
DELETE FROM borrador_producto WHERE cuentaClave = :cuentaClave;
